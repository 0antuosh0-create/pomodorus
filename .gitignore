.DS_Store

# Node
node_modules/
*.log

# Build output
bin/
dist/
client/dist/
# The client is built into the Go binary's embed directory; the directory is
# tracked (embed needs it to exist) but its contents never are.
server/internal/web/dist/*
# Env & local runtime data — every secret lives here and none of it is committed.
.env
.env.*
!.env.example
pomodorus-data.json
upstream-config.json
!upstream-config.example.json

# Playwright
test-results/
playwright-report/

# TypeScript incremental build state
*.tsbuildinfo

# Deployment runbooks. They describe how the production host is configured —
# the firewall rules, the fail2ban thresholds, the hostname, the DNS topology —
# and this repository is public. They are kept on disk and deliberately not
# tracked. Move them to a private repo if more than one person needs them.
docs/deploy-vps.md
docs/liara-email.md
